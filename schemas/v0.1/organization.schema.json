{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Organization",
  "type": "object",
  "required": [
    "id",
    "name",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "short_name": {
      "type": "string",
      "maxLength": 40
    },
    "status": {
      "enum": [
        "active",
        "suspended",
        "archived"
      ]
    }
  },
  "additionalProperties": false
}