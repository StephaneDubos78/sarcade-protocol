{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sarcade.org/schema/v0.1/common.schema.json",
  "title": "SARCADE Common Types v0.1",
  "type": "object",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "position": {
      "type": "object",
      "required": [
        "lat",
        "lon",
        "time"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "alt_m": {
          "type": "number"
        },
        "accuracy_m": {
          "type": "number",
          "minimum": 0
        },
        "heading_deg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "speed_mps": {
          "type": "number",
          "minimum": 0
        },
        "time": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    }
  }
}