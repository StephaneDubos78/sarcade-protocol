{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Team",
  "type": "object",
  "required": [
    "id",
    "event_id",
    "name"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "status": {
      "enum": [
        "available",
        "assigned",
        "engaged",
        "offline",
        "unknown"
      ]
    }
  },
  "additionalProperties": false
}