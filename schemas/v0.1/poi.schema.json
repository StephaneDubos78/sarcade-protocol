{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POI",
  "type": "object",
  "required": [
    "id",
    "event_id",
    "kind",
    "lat",
    "lon",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "maxLength": 64
    },
    "label": {
      "type": "string",
      "maxLength": 160
    },
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "lon": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}