{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SyncResult",
  "type": "object",
  "required": [
    "operation_id",
    "status",
    "server_time"
  ],
  "properties": {
    "operation_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "accepted",
        "duplicate",
        "conflict",
        "rejected"
      ]
    },
    "server_time": {
      "type": "string",
      "format": "date-time"
    },
    "server_version": {
      "type": "integer",
      "minimum": 0
    },
    "sync_cursor": {
      "type": "string"
    },
    "reason_code": {
      "type": "string",
      "maxLength": 64
    }
  },
  "additionalProperties": false
}