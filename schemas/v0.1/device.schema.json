{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Device",
  "type": "object",
  "required": [
    "id",
    "kind"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "team_id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "phone",
        "tablet",
        "desktop",
        "watch",
        "gateway",
        "radio",
        "other"
      ]
    },
    "callsign": {
      "type": "string",
      "maxLength": 32
    }
  },
  "additionalProperties": false
}